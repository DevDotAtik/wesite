            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1C. Authentication & 2FA Security Engine",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Credential Authentication:",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Email + Password with bcryptjs (salt rounds: 10)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - User registration & password recovery token flow"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Session Management: Signed JWT tokens in HTTP-only cookies"
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Google OAuth 2.0 Integration:",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Google Identity Services token verification via google-auth-library"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Auto-account provision & seamless profile synchronization"
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Zero-Cost Two-Factor Authentication (2FA TOTP):",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - RFC 6238 standard Time-based One-Time Password via otplib"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Real-time QR Code generation via qrcode SVG renderer"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Multi-step Verification Guard on Login (/api/auth/login/verify-2fa)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Cryptographic Secret: Stored in models/User.twoFactorSecret"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - 8 Single-use Emergency Backup Recovery Codes"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - 100% Free: No SMS gateway costs, works with Google Auth / 1Password"
                }
              ]
            }
