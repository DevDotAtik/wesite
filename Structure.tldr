        "size": "m",
        "font": "draw",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "1A. Next.js 16 Web Application (App Router)",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Neo-Brutalist Design System:",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Space Grotesk typography, 3px solid borders, offset shadows"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - CSS Custom tokens: --nb-bg, --nb-surface, --nb-card, --nb-border"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Dark mode radial gradient overlay & grain texture"
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Navigation & Shell Componentry:",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Top Navbar: Global search, Grid/List view toggle, Quick +Add"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - Mac-style Finder Sidebar (MacSidebar):"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    ↳ Organizer: All, Unsorted, Favorites, Recently Added, Most Visited"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    ↳ Media Types: Articles, Images, Videos, Documents"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    ↳ Nested Collections: Tree with parent-child folders, colors, counts"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "    ↳ Tags Cloud: Live tag counters & instant filter pills"
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Core Product Views:",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - /dashboard: Library with regex search, smart sort, batch actions"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - /news: Tech & HackerNews RSS feed aggregator"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - /monitoring: Website heartbeat, HTTP status 200/404/500, response ms"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - /todo: Task checklist tied directly to saved bookmarks"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - /analytics: Contribution streaks, heatmaps, folder distribution"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  - /settings: Profile, 2FA TOTP configuration, Import/Export"
                }
              ]
            }
          ]
        }
      },
